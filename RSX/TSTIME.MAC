	.TITLE	TSTIME	ASK NODES' TIMESTAMP OBJECTS FOR THE TIME
	.IDENT	/02/
;
;	>TSTIME NODE [NODE...]		(INSTALLED, SEE BELOW)
;	>RUN TSTIME			(PROMPTS FOR THE NODES)
;
; FOR EACH NODE, CONNECTS TO NODE::"0=TIMESTAMP", SENDS "UA" AND PRINTS
; THE ASCII REPLY, THEN SENDS "UB" AND PRINTS THE 8 BYTE VMS BINARY TIME
; AS FOUR OCTAL WORDS, LOW ORDER WORD FIRST.  THE NODES ARE ASKED ONE
; AFTER ANOTHER IN THE SAME RUN, SO THEIR CLOCKS CAN BE COMPARED.
;
; BUILD:
;	>MAC TSTIME,TSTIME/-SP=LB:[1,1]NETLIB/ML,SY:TSTIME
;	>TKB
;	TKB>TSTIME/-FP=TSTIME
;	TKB>/
;	ENTER OPTIONS:
;	TKB>ASG=NS0:1:2,TI0:5
;	TKB>//
;	>INS TSTIME/TASK=...TST
;
	.MCALL	OPNW$S,CONW$S,SNDW$S,RECW$S,DSCW$S,CLSW$S,CONB$$
	.MCALL	QIOW$S,EXIT$S,GMCR$,DIR$

NETLUN	=	1		; NETWORK (MAILBOX) LUN
LNKLUN	=	2		; LOGICAL LINK LUN
TILUN	=	5		; TERMINAL
EFN	=	1

CONBLK:	CONB$$	,0,1,TIMESTAMP	; NODE NAME IS FILLED IN FOR EACH NODE
	.EVEN
GMCR:	GMCR$
IOST:	.BLKW	2
ARGS:	.BLKW	2
LINPTR:	.WORD	0		; WHAT IS LEFT OF THE NODE LIST
LINLEN:	.WORD	0
BUF:	.BLKW	32.
LINE:	.BLKB	80.
OUT:	.BLKB	100.
REQA:	.ASCII	/UA/
REQB:	.ASCII	/UB/
PROMPT:	.ASCII	/NODES? /
PRMLEN	=	.-PROMPT
FMTB:	.ASCIZ	/%P %P %P %P/
FMTE:	.ASCIZ	/STEP %P FAILED, STATUS %P/
	.EVEN

START:	CALL	GETLIN
	OPNW$S	#NETLUN,#EFN,#IOST
	MOV	#1,R3
	CALL	CHECK
	BCS	3$
1$:	CALL	NXTNOD
	BCS	2$
	CALL	ASK
	BR	1$
2$:	CLSW$S	#NETLUN,#EFN,#IOST
3$:	EXIT$S

; ASK THE NODE NAMED IN CONBLK.  THE MACROS EXPAND TO MORE THAN A BRANCH
; CAN REACH, SO ERRORS JUMP TO THE END.
ASK:	CONW$S	#LNKLUN,#EFN,#IOST,,<#CONBLK>
	MOV	#2,R3
	CALL	CHECK
	BCC	21$
	JMP	9$
21$:

	SNDW$S	#LNKLUN,#EFN,#IOST,,<#REQA,#2>
	MOV	#3,R3
	CALL	CHECK
	BCC	22$
	JMP	8$
22$:
	RECW$S	#LNKLUN,#EFN,#IOST,,<#BUF,#64.>
	MOV	#4,R3
	CALL	CHECK
	BCC	23$
	JMP	8$
23$:
	CALL	PREFIX
	MOV	IOST+2,R2
	BEQ	2$
	MOV	#BUF,R1
1$:	MOVB	(R1)+,(R0)+
	INC	R4
	SOB	R2,1$
2$:	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#OUT,R4,#40>

	SNDW$S	#LNKLUN,#EFN,#IOST,,<#REQB,#2>
	MOV	#5,R3
	CALL	CHECK
	BCC	24$
	JMP	8$
24$:
	RECW$S	#LNKLUN,#EFN,#IOST,,<#BUF,#64.>
	MOV	#6,R3
	CALL	CHECK
	BCC	25$
	JMP	8$
25$:
	CALL	PREFIX
	MOV	R4,-(SP)
	MOV	#FMTB,R1
	MOV	#BUF,R2
	CALL	$EDMSG
	ADD	(SP)+,R1
	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#OUT,R1,#40>

8$:	DSCW$S	#LNKLUN,#EFN,#IOST
9$:	RETURN

; FIND THE NODE LIST: THE MCR COMMAND LINE AFTER THE COMMAND NAME, OR
; ELSE ASK FOR IT.
GETLIN:	DIR$	#GMCR
	BCS	2$
	MOV	#GMCR+2,R0
	MOV	$DSW,R1
1$:	DEC	R1
	BMI	2$
	CMPB	(R0)+,#40
	BNE	1$
	TST	R1
	BNE	3$
2$:	QIOW$S	#IO.RPR,#TILUN,#EFN,,#IOST,,<#LINE,#80.,,#PROMPT,#PRMLEN,#'$>
	MOV	#LINE,R0
	MOV	IOST+2,R1
3$:	MOV	R0,LINPTR
	MOV	R1,LINLEN
	RETURN

; PUT THE NEXT NODE NAME FROM THE LIST INTO CONBLK, UPPER CASE AND SPACE
; FILLED.  NAMES ARE SEPARATED BY SPACES OR COMMAS, AND A TRAILING "::"
; IS ALLOWED.  CARRY SET WHEN THERE ARE NO MORE.
NXTNOD:	MOV	LINPTR,R0
	MOV	LINLEN,R1
1$:	DEC	R1		; SKIP SEPARATORS
	BMI	9$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	1$
	CMPB	R5,#',
	BEQ	1$
	DEC	R0		; BACK UP TO THE NAME
	INC	R1
	MOV	#CONBLK,R2
	MOV	#6,R3
2$:	MOVB	#40,(R2)+
	SOB	R3,2$
	MOV	#CONBLK,R2
	MOV	#6,R3
3$:	DEC	R1
	BMI	5$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	5$		; SPACE OR CONTROL CHARACTER ENDS IT
	CMPB	R5,#',
	BEQ	5$
	CMPB	R5,#':
	BEQ	3$
	CMPB	R5,#141		; LOWER CASE A
	BLO	4$
	CMPB	R5,#172		; LOWER CASE Z
	BHI	4$
	BICB	#40,R5
4$:	TST	R3		; LONGER THAN 6: IGNORE THE REST
	BEQ	3$
	MOVB	R5,(R2)+
	DEC	R3
	BR	3$
5$:	TST	R1
	BPL	6$
	CLR	R1
6$:	MOV	R0,LINPTR
	MOV	R1,LINLEN
	CLC
	RETURN
9$:	SEC
	RETURN

; START A LINE IN OUT WITH "NODE:: ".  R0 POINTS PAST IT, R4 IS ITS
; LENGTH.
PREFIX:	MOV	#OUT,R0
	MOV	#CONBLK,R1
	MOV	#6,R2
1$:	CMPB	(R1),#40
	BEQ	2$
	MOVB	(R1)+,(R0)+
	SOB	R2,1$
2$:	MOVB	#':,(R0)+
	MOVB	#':,(R0)+
	MOVB	#40,(R0)+
	MOV	R0,R4
	SUB	#OUT,R4
	RETURN

; CHECK THE LAST CALL.  CARRY SET IS A DIRECTIVE ERROR, WITH THE CODE IN
; $DSW; OTHERWISE THE FIRST BYTE OF IOST IS POSITIVE ON SUCCESS.  ON
; FAILURE REPORT THE STEP NUMBER (R3) AND THE STATUS, AND RETURN WITH
; CARRY SET.
CHECK:	BCS	1$
	TSTB	IOST
	BGT	3$
	MOVB	IOST,R4
	BR	2$
1$:	MOV	$DSW,R4
2$:	MOV	R3,ARGS
	MOV	R4,ARGS+2
	CALL	PREFIX
	MOV	R4,-(SP)
	MOV	#FMTE,R1
	MOV	#ARGS,R2
	CALL	$EDMSG
	ADD	(SP)+,R1
	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#OUT,R1,#40>
	SEC
	RETURN
3$:	CLC
	RETURN

	.END	START
