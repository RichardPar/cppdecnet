	.TITLE	TSTIME	ASK NODES' TIMESTAMP OBJECTS FOR THE TIME
	.IDENT	/05/
;
;	>TSTIME NODE [NODE...]		(INSTALLED, SEE BELOW)
;	>RUN TSTIME			(PROMPTS FOR THE NODES)
;
; FOR EACH NODE, CONNECTS TO NODE::"0=TIMESTAMP" AND SENDS "UB", WHICH GETS
; THE TIME AS A VMS QUADWORD (100 NS UNITS SINCE 17-NOV-1858), AND PRINTS
; IT THE WAY TIM DOES, BUT WITH THE FULL YEAR:
;
;	>TSTIME CPPNOD
;	15:21:45 27-SEP-2026
;
; THE DATE ARITHMETIC IS GOOD FOR 2000 TO 2099.
;
; BUILD:
;	>MAC TSTIME,TSTIME/-SP=LB:[1,1]NETLIB/ML,SY:TSTIME
;	>TKB
;	TKB>TSTIME/-FP=TSTIME
;	TKB>/
;	ENTER OPTIONS:
;	TKB>ASG=NS0:1:2,TI0:5
;	TKB>//
;	>INS TSTIME/TASK=...TST
;
	.MCALL	OPNW$S,CONW$S,SNDW$S,RECW$S,DSCW$S,CLSW$S,CONB$$
	.MCALL	QIOW$S,EXIT$S,GMCR$,DIR$

NETLUN	=	1		; NETWORK (MAILBOX) LUN
LNKLUN	=	2		; LOGICAL LINK LUN
TILUN	=	5		; TERMINAL
EFN	=	1

; A GTIM$ BUFFER
T.YR	=	0		; YEAR - 1900
T.MO	=	2		; MONTH, 1-12
T.DA	=	4		; DAY
T.HR	=	6		; HOUR
T.MI	=	10		; MINUTE
T.SC	=	12		; SECOND
T.CT	=	14		; CLOCK TICK
T.CP	=	16		; TICKS PER SECOND

CONBLK:	CONB$$	,0,1,TIMESTAMP	; NODE NAME IS FILLED IN FOR EACH NODE
	.EVEN
GMCR:	GMCR$
IOST:	.BLKW	2
ARGS:	.BLKW	2
LINPTR:	.WORD	0		; WHAT IS LEFT OF THE NODE LIST
LINLEN:	.WORD	0
RBUF:	.BLKW	8.		; THE TIME, AS A GTIM$ BUFFER
BUF:	.BLKW	32.
LINE:	.BLKB	80.
OUT:	.BLKB	100.
REQB:	.ASCII	/UB/
PROMPT:	.ASCII	/NODES? /
PRMLEN	=	.-PROMPT
MDAYS:	.BYTE	31.,28.,31.,30.,31.,30.,31.,31.,30.,31.,30.,31.
FMTT:	.ASCIZ	/%3Z /
MONTHS:	.ASCII	/JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC/
FMTE:	.ASCIZ	/STEP %P FAILED, STATUS %P/
	.EVEN

START:	CALL	GETLIN
	OPNW$S	#NETLUN,#EFN,#IOST
	MOV	#1,R3
	CALL	CHECK
	BCS	3$
1$:	CALL	NXTNOD
	BCS	2$
	CALL	ASK
	BR	1$
2$:	CLSW$S	#NETLUN,#EFN,#IOST
3$:	EXIT$S

; ASK THE NODE NAMED IN CONBLK.  THE MACROS EXPAND TO MORE THAN A BRANCH
; CAN REACH, SO ERRORS JUMP TO THE END.
ASK:	CONW$S	#LNKLUN,#EFN,#IOST,,<#CONBLK>
	MOV	#2,R3
	CALL	CHECK
	BCC	21$
	JMP	9$
21$:	SNDW$S	#LNKLUN,#EFN,#IOST,,<#REQB,#2>
	MOV	#3,R3
	CALL	CHECK
	BCC	24$
	JMP	8$
24$:	RECW$S	#LNKLUN,#EFN,#IOST,,<#BUF,#64.>
	MOV	#4,R3
	CALL	CHECK
	BCC	25$
	JMP	8$
25$:	CALL	DECBIN
	MOV	#OUT,R0
	MOV	#RBUF,R3
	CALL	RSXTIM
	CALL	PRINT

8$:	DSCW$S	#LNKLUN,#EFN,#IOST
9$:	RETURN

; FIND THE NODE LIST: THE MCR COMMAND LINE AFTER THE COMMAND NAME, OR
; ELSE ASK FOR IT.
GETLIN:	DIR$	#GMCR
	BCS	2$
	MOV	#GMCR+2,R0
	MOV	$DSW,R1
1$:	DEC	R1
	BMI	2$
	CMPB	(R0)+,#40
	BNE	1$
	TST	R1
	BNE	3$
2$:	QIOW$S	#IO.RPR,#TILUN,#EFN,,#IOST,,<#LINE,#80.,,#PROMPT,#PRMLEN,#'$>
	MOV	#LINE,R0
	MOV	IOST+2,R1
3$:	MOV	R0,LINPTR
	MOV	R1,LINLEN
	RETURN

; PUT THE NEXT NODE NAME FROM THE LIST INTO CONBLK, UPPER CASE AND SPACE
; FILLED.  NAMES ARE SEPARATED BY SPACES OR COMMAS, AND A TRAILING "::"
; IS ALLOWED.  CARRY SET WHEN THERE ARE NO MORE.
NXTNOD:	MOV	LINPTR,R0
	MOV	LINLEN,R1
1$:	DEC	R1		; SKIP SEPARATORS
	BMI	9$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	1$
	CMPB	R5,#',
	BEQ	1$
	DEC	R0		; BACK UP TO THE NAME
	INC	R1
	MOV	#CONBLK,R2
	MOV	#6,R3
2$:	MOVB	#40,(R2)+
	SOB	R3,2$
	MOV	#CONBLK,R2
	MOV	#6,R3
3$:	DEC	R1
	BMI	5$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	5$		; SPACE OR CONTROL CHARACTER ENDS IT
	CMPB	R5,#',
	BEQ	5$
	CMPB	R5,#':
	BEQ	3$
	CMPB	R5,#141		; LOWER CASE A
	BLO	4$
	CMPB	R5,#172		; LOWER CASE Z
	BHI	4$
	BICB	#40,R5
4$:	TST	R3		; LONGER THAN 6: IGNORE THE REST
	BEQ	3$
	MOVB	R5,(R2)+
	DEC	R3
	BR	3$
5$:	TST	R1
	BPL	6$
	CLR	R1
6$:	MOV	R0,LINPTR
	MOV	R1,LINLEN
	CLC
	RETURN
9$:	SEC
	RETURN

; TURN THE VMS TIME IN BUF INTO A GTIM$ BUFFER IN RBUF.  BUF IS USED UP.
DECBIN:	MOV	#BUF,R5
	MOV	#1000.,R2	; 100 NS UNITS TO 100 US
	CALL	DIV64
	MOV	#100.,R2	; TO HUNDREDTHS
	CALL	DIV64
	MOV	#100.,R2
	CALL	DIV64
	MOV	R1,RBUF+T.CT
	MOV	#100.,RBUF+T.CP
	MOV	#60.,R2
	CALL	DIV64
	MOV	R1,RBUF+T.SC
	MOV	#60.,R2
	CALL	DIV64
	MOV	R1,RBUF+T.MI
	MOV	#24.,R2
	CALL	DIV64
	MOV	R1,RBUF+T.HR
	MOV	BUF,R1		; DAYS SINCE 17-NOV-1858
	SUB	#51544.,R1	; DAYS SINCE 1-JAN-2000
	MOV	#100.,R3	; YEAR - 1900
1$:	MOV	#365.,R0
	BIT	#3,R3
	BNE	2$
	INC	R0
2$:	CMP	R1,R0
	BLO	3$
	SUB	R0,R1
	INC	R3
	BR	1$
3$:	MOV	R3,RBUF+T.YR
	MOV	#MDAYS,R4
	MOV	#1,R2
4$:	MOVB	(R4)+,R0
	CMP	R2,#2		; FEBRUARY IN A LEAP YEAR
	BNE	5$
	BIT	#3,R3
	BNE	5$
	INC	R0
5$:	CMP	R1,R0
	BLO	6$
	SUB	R0,R1
	INC	R2
	BR	4$
6$:	MOV	R2,RBUF+T.MO
	INC	R1
	MOV	R1,RBUF+T.DA
	RETURN

; DIVIDE THE 8 BYTE LITTLE ENDIAN NUMBER AT R5 BY R2 (1000. AT MOST) IN
; PLACE, A BYTE AT A TIME SO THE QUOTIENT ALWAYS FITS.  REMAINDER IN R1.
DIV64:	MOV	R3,-(SP)
	MOV	R4,-(SP)
	MOV	R5,R4
	ADD	#8.,R4
	CLR	R1
1$:	MOV	R1,R0
	MUL	#256.,R0	; R0:R1 = REMAINDER * 256
	CLR	R3
	BISB	-(R4),R3
	ADD	R3,R1
	ADC	R0
	DIV	R2,R0		; R0 = QUOTIENT, R1 = REMAINDER
	MOVB	R0,(R4)
	CMP	R4,R5
	BHI	1$
	MOV	(SP)+,R4
	MOV	(SP)+,R3
	RETURN

; ADD "HH:MM:SS DD-MMM-YYYY" FOR THE GTIM$ BUFFER AT R3 TO THE LINE AT
; R0 - TIM'S LAYOUT, BUT %Y ONLY DOES TWO DIGIT YEARS SO THE DATE IS DONE
; HERE.  R0 IS LEFT AT THE END.
RSXTIM:	MOV	R3,-(SP)
	MOV	R0,-(SP)
	MOV	#FMTT,R1
	MOV	R3,R2
	ADD	#T.HR,R2
	CALL	$EDMSG
	ADD	(SP)+,R1
	MOV	R1,R0
	MOV	(SP)+,R3
	MOV	T.DA(R3),R1
	CALL	PUT2
	MOVB	#'-,(R0)+
	MOV	T.MO(R3),R1
	DEC	R1
	MUL	#3,R1
	ADD	#MONTHS,R1
	MOVB	(R1)+,(R0)+
	MOVB	(R1)+,(R0)+
	MOVB	(R1)+,(R0)+
	MOVB	#'-,(R0)+
	CLR	R4
	MOV	T.YR(R3),R5
	ADD	#1900.,R5
	DIV	#100.,R4	; R4 = CENTURY, R5 = YEAR IN IT
	MOV	R4,R1
	CALL	PUT2
	MOV	R5,R1
	CALL	PUT2
	RETURN

; ADD R1 (0-99) TO THE LINE AT R0 AS TWO DIGITS.
PUT2:	MOV	R2,-(SP)
	MOV	R3,-(SP)
	CLR	R2
	MOV	R1,R3
	DIV	#10.,R2
	ADD	#'0,R2
	MOVB	R2,(R0)+
	ADD	#'0,R3
	MOVB	R3,(R0)+
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	RETURN

; START A LINE IN OUT WITH THE NODE NAME AT R1 AND "::", FOR ERROR
; MESSAGES.  R0 POINTS PAST IT.
PREFIX:	MOV	#OUT,R0
	MOV	#6,R2
1$:	CMPB	(R1),#40
	BEQ	2$
	MOVB	(R1)+,(R0)+
	SOB	R2,1$
2$:	MOVB	#':,(R0)+
	MOVB	#':,(R0)+
3$:	MOVB	#40,(R0)+
	CMP	R0,#OUT+9.
	BLO	3$
	RETURN

; PRINT THE LINE FROM OUT TO R0.
PRINT:	MOV	R0,R1
	SUB	#OUT,R1
	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#OUT,R1,#40>
	RETURN

; CHECK THE LAST CALL.  CARRY SET IS A DIRECTIVE ERROR, WITH THE CODE IN
; $DSW; OTHERWISE THE FIRST BYTE OF IOST IS POSITIVE ON SUCCESS.  ON
; FAILURE REPORT THE STEP NUMBER (R3) AND THE STATUS, AND RETURN WITH
; CARRY SET.
CHECK:	BCS	1$
	TSTB	IOST
	BGT	3$
	MOVB	IOST,R4
	BR	2$
1$:	MOV	$DSW,R4
2$:	MOV	R3,ARGS
	MOV	R4,ARGS+2
	MOV	#CONBLK,R1
	CALL	PREFIX
	MOV	R0,-(SP)
	MOV	#FMTE,R1
	MOV	#ARGS,R2
	CALL	$EDMSG
	ADD	(SP)+,R1
	MOV	R1,R0
	CALL	PRINT
	SEC
	RETURN
3$:	CLC
	RETURN

	.END	START
