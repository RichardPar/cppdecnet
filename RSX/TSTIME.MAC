	.TITLE	TSTIME	ASK NODES' TIMESTAMP OBJECTS FOR THE TIME
	.IDENT	/09/
;
;	>TSTIME NODE [NODE...]		SHOW EACH NODE'S TIME
;	>TSTIME NODE [NODE...]/SET	SET OUR CLOCK FROM THE FIRST THAT ANSWERS
;	>RUN TSTSYN			SET IT FROM THE NODES IN TSTIME$NODE
;
; FOR EACH NODE, CONNECTS TO NODE::"0=TIMESTAMP" AND SENDS "UB", WHICH GETS
; THE TIME AS A VMS QUADWORD (100 NS UNITS SINCE 17-NOV-1858).  THAT IS
; UTC; THE LOCAL OFFSET IN SYS$UTC_OFFSET (MINUTES, AS SET UP BY
; LB:[1,2]TZ.CMD) IS ADDED, AND IT IS PRINTED THE WAY TIM DOES, BUT WITH
; THE FULL YEAR:
;
;	>TSTIME CPPNOD
;	16:21:45 27-SEP-2026
;
; WITH /SET THE TIME IS ALSO LOADED INTO THE SYSTEM CLOCK.  RUN WITHOUT A
; COMMAND LINE -- BY RUN, OR ON A SCHEDULE -- IT TAKES THE NODE LIST FROM
; THE LOGICAL TSTIME$NODE AND SETS THE CLOCK, PRINTING ONLY ERRORS:
;
;	>INS TSTIME/TASK=TSTSYN		(RUN WON'T TAKE A ...XXX NAME)
;	>DFL CPPNOD=TSTIME$NODE/GBL
;	>RUN TSTSYN 1M/RSI=1H
;
; THE DATE ARITHMETIC IS GOOD FOR 2000 TO 2099.
;
; BUILD:
;	>MAC TSTIME,TSTIME/-SP=LB:[1,1]NETLIB/ML,SY:TSTIME
;	>TKB
;	TKB>TSTIME/-FP/PR:0=TSTIME
;	TKB>/
;	ENTER OPTIONS:
;	TKB>ASG=NS0:1:2,TI0:5
;	TKB>//
;	>INS TSTIME/TASK=...TST
;
	.MCALL	OPNW$S,CONW$S,SNDW$S,RECW$S,DSCW$S,CLSW$S,CONB$$
	.MCALL	QIOW$S,EXIT$S,GMCR$,DIR$,GTIM$S,STIM$S,TLOG$S

NETLUN	=	1		; NETWORK (MAILBOX) LUN
LNKLUN	=	2		; LOGICAL LINK LUN
TILUN	=	5		; TERMINAL
EFN	=	1

; GTIM$/STIM$ BUFFERS ARE ADDRESSED WITH THE G.TIXX OFFSETS FROM SYSLIB.

CONBLK:	CONB$$	,0,1,TIMESTAMP	; NODE NAME IS FILLED IN FOR EACH NODE
	.EVEN
GMCR:	GMCR$
IOST:	.BLKW	2
ARGS:	.BLKW	2
LINPTR:	.WORD	0		; WHAT IS LEFT OF THE NODE LIST
LINLEN:	.WORD	0
SETFLG:	.WORD	0		; SET THE CLOCK
QUIET:	.WORD	0		; ONLY PRINT ERRORS
OKFLG:	.WORD	0		; THE LAST NODE ANSWERED
OFFSET:	.WORD	0		; LOCAL TIME - UTC, IN MINUTES
EQLEN:	.WORD	0
EQMOD:	.WORD	0
RBUF:	.BLKW	8.		; THE TIME, AS A GTIM$ BUFFER
TBUF:	.BLKW	8.		; OUR CLOCK
BUF:	.BLKW	32.
QSEC:	.BLKW	4		; SECONDS SINCE 17-NOV-1858
QDAYS:	.BLKW	4		; DAYS SINCE 17-NOV-1858
QREM:	.BLKW	4		; REMAINDER FROM $DIVQ
Q1E7:	.WORD	113200,230,0,0	; 10000000., 100 NS UNITS IN A SECOND
QDAY:	.WORD	50600,1,0,0	; 86400., SECONDS IN A DAY
EQBUF:	.BLKB	80.		; TSTIME$NODE
OFBUF:	.BLKB	16.		; SYS$UTC_OFFSET
OUT:	.BLKB	100.
REQB:	.ASCII	/UB/
LNOFF:	.ASCII	/SYS$UTC_OFFSET/
LNOFFL	=	.-LNOFF
LNNOD:	.ASCII	/TSTIME$NODE/
LNNODL	=	.-LNNOD
FMTE:	.ASCIZ	/STEP %P FAILED, STATUS %P/
USAGE:	.ASCII	|USAGE: TSTIME NODE[,NODE...][/SET]|
USELEN	=	.-USAGE
	.EVEN

START:	CALL	GETLIN
	BCS	3$
	CALL	GETOFF
	OPNW$S	#NETLUN,#EFN,#IOST
	MOV	#1,R3
	CALL	CHECK
	BCS	3$
1$:	CALL	NXTNOD
	BCS	2$
	CALL	ASK
	TST	SETFLG		; SETTING THE CLOCK, ONE ANSWER WILL DO
	BEQ	1$
	TST	OKFLG
	BEQ	1$
2$:	CLSW$S	#NETLUN,#EFN,#IOST
3$:	EXIT$S

; ASK THE NODE NAMED IN CONBLK.  THE MACROS EXPAND TO MORE THAN A BRANCH
; CAN REACH, SO ERRORS JUMP TO THE END.  OKFLG IS SET IF IT ANSWERED.
ASK:	CLR	OKFLG
	CONW$S	#LNKLUN,#EFN,#IOST,,<#CONBLK>
	MOV	#2,R3
	CALL	CHECK
	BCC	21$
	JMP	9$
21$:	SNDW$S	#LNKLUN,#EFN,#IOST,,<#REQB,#2>
	MOV	#3,R3
	CALL	CHECK
	BCC	24$
	JMP	8$
24$:	RECW$S	#LNKLUN,#EFN,#IOST,,<#BUF,#64.>
	MOV	#4,R3
	CALL	CHECK
	BCC	25$
	JMP	8$
25$:	CALL	DECBIN
	TST	SETFLG
	BEQ	26$
	CALL	SETCLK
	BCS	8$
26$:	TST	QUIET
	BNE	27$
	MOV	#OUT,R0
	MOV	#RBUF,R3
	CALL	RSXTIM
	CALL	PRINT
27$:	MOV	#1,OKFLG

8$:	DSCW$S	#LNKLUN,#EFN,#IOST
9$:	RETURN

; LOAD THE TIME IN RBUF INTO THE SYSTEM CLOCK.  CARRY SET IF IT FAILED.
; STIM$ IS PRIVILEGED, HENCE /PR:0 WHEN TASK BUILDING.
SETCLK:	STIM$S	#RBUF
	BCC	1$
	MOV	#5,R3
	CALL	CHECK
1$:	RETURN

; FIND THE NODE LIST: THE MCR COMMAND LINE AFTER THE COMMAND NAME, WITH
; AN OPTIONAL /SET ON THE END.  WITH NO COMMAND LINE AT ALL, THE NODES
; COME FROM TSTIME$NODE AND THE CLOCK IS SET QUIETLY.  CARRY SET IF
; THERE IS NOTHING TO DO.
GETLIN:	DIR$	#GMCR
	BCS	5$
	MOV	#GMCR+2,R0
	MOV	$DSW,R1
1$:	DEC	R1
	BMI	6$
	CMPB	(R0)+,#40
	BNE	1$
	TST	R1
	BEQ	6$
	MOV	R0,LINPTR
	MOV	R1,LINLEN
	CALL	SWITCH
	BCS	6$
	RETURN
5$:	TLOG$S	,#0,,#LNNOD,#LNNODL,#EQBUF,#80.,#EQLEN,#EQMOD
	BCS	6$
	MOV	#EQBUF,LINPTR
	MOV	EQLEN,LINLEN
	MOV	#1,SETFLG
	MOV	#1,QUIET
	CLC
	RETURN
6$:	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#USAGE,#USELEN,#40>
	SEC
	RETURN

; LOOK FOR A SWITCH AFTER THE NODES.  /SET IS THE ONLY ONE.  THE NODE LIST
; IS CUT OFF AT THE SLASH.  CARRY SET IF IT ISN'T ONE WE KNOW.
SWITCH:	MOV	LINPTR,R0
	MOV	LINLEN,R1
1$:	DEC	R1
	BMI	9$
	CMPB	(R0)+,#'/
	BNE	1$
	MOV	R0,R2
	DEC	R2
	SUB	LINPTR,R2
	MOV	R2,LINLEN
	CMP	R1,#2
	BLT	8$
	MOVB	(R0)+,R2
	BICB	#40,R2
	CMPB	R2,#'S
	BNE	8$
	MOVB	(R0)+,R2
	BICB	#40,R2
	CMPB	R2,#'E
	BNE	8$
	MOV	#1,SETFLG
9$:	CLC
	RETURN
8$:	SEC
	RETURN

; OFFSET = SYS$UTC_OFFSET, MINUTES EAST OF UTC.  LEFT AT ZERO IF IT ISN'T
; DEFINED OR ISN'T A NUMBER.
GETOFF:	TLOG$S	,#0,,#LNOFF,#LNOFFL,#OFBUF,#16.,#EQLEN,#EQMOD
	BCS	9$
	MOV	#OFBUF,R0
	MOV	EQLEN,R1
	CLR	R5		; THE VALUE
	CLR	R4		; NEGATIVE
	TST	R1
	BEQ	9$
	CMPB	(R0),#'-
	BNE	1$
	INC	R4
	INC	R0
	DEC	R1
	BR	2$
1$:	CMPB	(R0),#'+
	BNE	2$
	INC	R0
	DEC	R1
2$:	DEC	R1
	BMI	3$
	MOVB	(R0)+,R3
	SUB	#'0,R3
	CMP	R3,#9.
	BHI	9$		; NOT A NUMBER
	MUL	#10.,R5
	ADD	R3,R5
	BR	2$
3$:	TST	R4
	BEQ	4$
	NEG	R5
4$:	MOV	R5,OFFSET
9$:	RETURN

; PUT THE NEXT NODE NAME FROM THE LIST INTO CONBLK, UPPER CASE AND SPACE
; FILLED.  NAMES ARE SEPARATED BY SPACES OR COMMAS, AND A TRAILING "::"
; IS ALLOWED.  CARRY SET WHEN THERE ARE NO MORE.
NXTNOD:	MOV	LINPTR,R0
	MOV	LINLEN,R1
1$:	DEC	R1		; SKIP SEPARATORS
	BMI	9$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	1$
	CMPB	R5,#',
	BEQ	1$
	DEC	R0		; BACK UP TO THE NAME
	INC	R1
	MOV	#CONBLK,R2
	MOV	#6,R3
2$:	MOVB	#40,(R2)+
	SOB	R3,2$
	MOV	#CONBLK,R2
	MOV	#6,R3
3$:	DEC	R1
	BMI	5$
	MOVB	(R0)+,R5
	CMPB	R5,#40
	BLOS	5$		; SPACE OR CONTROL CHARACTER ENDS IT
	CMPB	R5,#',
	BEQ	5$
	CMPB	R5,#':
	BEQ	3$
	CMPB	R5,#141		; LOWER CASE A
	BLO	4$
	CMPB	R5,#172		; LOWER CASE Z
	BHI	4$
	BICB	#40,R5
4$:	TST	R3		; LONGER THAN 6: IGNORE THE REST
	BEQ	3$
	MOVB	R5,(R2)+
	DEC	R3
	BR	3$
5$:	TST	R1
	BPL	6$
	CLR	R1
6$:	MOV	R0,LINPTR
	MOV	R1,LINLEN
	CLC
	RETURN
9$:	SEC
	RETURN

; TURN THE VMS TIME IN BUF INTO LOCAL TIME AS A GTIM$ BUFFER IN RBUF.
; THE PART OF A SECOND IS IN CLOCK TICKS AT THIS SYSTEM'S RATE, WHICH
; COMES FROM GTIM$, SO RBUF CAN GO STRAIGHT TO STIM$.
DECBIN:	MOV	#RBUF,R5
	MOV	#TBUF,R4
	GTIM$S	R4
	MOV	G.TICP(R4),G.TICP(R5)
	MOV	#Q1E7,R0	; SECONDS, AND 100 NS UNITS LEFT OVER
	MOV	#BUF,R1
	MOV	#QSEC,R2
	MOV	#QREM,R3
	CALL	$DIVQ
	MOV	QREM+2,R0	; TICKS = LEFT OVER / 1000. * TICKS/SEC / 10000.
	MOV	QREM,R1
	DIV	#1000.,R0
	MUL	G.TICP(R4),R0
	DIV	#10000.,R0
	MOV	R0,G.TICT(R5)
	MOV	OFFSET,R0	; MAKE IT LOCAL: ADD OFFSET*60. SECONDS
	MUL	#60.,R0		; R0:R1, SIGNED
	SXT	R2		; R2 = SIGN OF IT
	ADD	R1,QSEC
	ADC	QSEC+2
	ADC	QSEC+4
	ADC	QSEC+6
	ADD	R0,QSEC+2
	ADC	QSEC+4
	ADC	QSEC+6
	ADD	R2,QSEC+4
	ADC	QSEC+6
	ADD	R2,QSEC+6
	MOV	#QDAY,R0	; DAYS, AND THE SECOND OF THE DAY
	MOV	#QSEC,R1
	MOV	#QDAYS,R2
	MOV	#QREM,R3
	CALL	$DIVQ
	MOV	QREM+2,R0
	MOV	QREM,R1
	DIV	#3600.,R0
	MOV	R0,G.TIHR(R5)
	CLR	R0
	DIV	#60.,R0
	MOV	R0,G.TIMI(R5)
	MOV	R1,G.TISC(R5)
	MOV	QDAYS,R1	; DAYS SINCE 17-NOV-1858
	SUB	#51544.,R1	; DAYS SINCE 1-JAN-2000
	MOV	#100.,R3	; YEAR - 1900
1$:	MOV	#365.,R0
	BIT	#3,R3
	BNE	2$
	INC	R0
2$:	CMP	R1,R0
	BLO	3$
	SUB	R0,R1
	INC	R3
	BR	1$
3$:	MOV	R3,G.TIYR(R5)
	MOV	#1,R2		; MONTH
4$:	MOVB	$DAYTB-1(R2),R0	; JANUARY FIRST; FEBRUARY IS 29
	CMP	R2,#2
	BNE	5$
	BIT	#3,R3
	BEQ	5$
	DEC	R0
5$:	CMP	R1,R0
	BLO	6$
	SUB	R0,R1
	INC	R2
	BR	4$
6$:	MOV	R2,G.TIMO(R5)
	INC	R1
	MOV	R1,G.TIDA(R5)
	RETURN

; ADD "HH:MM:SS DD-MMM-YYYY" FOR THE GTIM$ BUFFER AT R3 TO THE LINE AT
; R0 - TIM'S LAYOUT, BUT WITH $DAT4'S FULL YEAR.  R0 IS LEFT AT THE END.
RSXTIM:	MOV	R3,-(SP)
	MOV	R3,R1
	ADD	#G.TIHR,R1
	MOV	#3,R2
	CALL	$TIM
	MOVB	#40,(R0)+
	MOV	(SP)+,R1
	CALL	$DAT4
	RETURN

; START A LINE IN OUT WITH THE NODE NAME AT R1 AND "::", FOR ERROR
; MESSAGES.  R0 POINTS PAST IT.
PREFIX:	MOV	#OUT,R0
	MOV	#6,R2
1$:	CMPB	(R1),#40
	BEQ	2$
	MOVB	(R1)+,(R0)+
	SOB	R2,1$
2$:	MOVB	#':,(R0)+
	MOVB	#':,(R0)+
3$:	MOVB	#40,(R0)+
	CMP	R0,#OUT+9.
	BLO	3$
	RETURN

; PRINT THE LINE FROM OUT TO R0.
PRINT:	MOV	R0,R1
	SUB	#OUT,R1
	QIOW$S	#IO.WVB,#TILUN,#EFN,,,,<#OUT,R1,#40>
	RETURN

; CHECK THE LAST CALL.  CARRY SET IS A DIRECTIVE ERROR, WITH THE CODE IN
; $DSW; OTHERWISE THE FIRST BYTE OF IOST IS POSITIVE ON SUCCESS.  ON
; FAILURE REPORT THE STEP NUMBER (R3) AND THE STATUS, AND RETURN WITH
; CARRY SET.
CHECK:	BCS	1$
	TSTB	IOST
	BGT	3$
	MOVB	IOST,R4
	BR	2$
1$:	MOV	$DSW,R4
2$:	MOV	R3,ARGS
	MOV	R4,ARGS+2
	MOV	#CONBLK,R1
	CALL	PREFIX
	MOV	R0,-(SP)
	MOV	#FMTE,R1
	MOV	#ARGS,R2
	CALL	$EDMSG
	ADD	(SP)+,R1
	MOV	R1,R0
	CALL	PRINT
	SEC
	RETURN
3$:	CLC
	RETURN

	.END	START
